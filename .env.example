NEXT_PUBLIC_APP_URL=http://localhost:3000
# pglite = persistent embedded PostgreSQL; postgres = Supabase / PostgreSQL
DB_PROVIDER=pglite
PGLITE_DATA_DIR=.data/tableline
DATABASE_URL=
DATABASE_SSL=true
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# A development-only password is available when unset. Required in production.
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional dedicated worker bearer secret. Otherwise derived from SESSION_SECRET.
CRON_SECRET=
# Set true only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
WHATSAPP_PROVIDER=mock
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
META_TEMPLATE_LANGUAGE=en
META_TEMPLATE_QUEUE_JOINED=
META_TEMPLATE_CUSTOMER_CALLED=
META_TEMPLATE_ORDER_CONFIRMED=
META_TEMPLATE_PAYMENT_SUCCESSFUL=
META_TEMPLATE_RESERVATION_CREATED=
META_TEMPLATE_RESERVATION_CONFIRMATION=
META_TEMPLATE_RESERVATION_REMINDER_FIRST=
META_TEMPLATE_RESERVATION_REMINDER_SECOND=
META_TEMPLATE_RESERVATION_CANCELLED=
META_TEMPLATE_TABLE_READY=
META_TEMPLATE_FEEDBACK_REQUEST=
PAYMENT_PROVIDER=mock
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
